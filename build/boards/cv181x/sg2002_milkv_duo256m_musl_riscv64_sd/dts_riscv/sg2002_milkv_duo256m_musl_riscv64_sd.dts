/dts-v1/;
#include "cv181x_base_riscv.dtsi"
#include "cv181x_asic_qfn.dtsi"
#include "cv181x_asic_sd.dtsi"
#include "cv181x_default_memmap.dtsi"

/ {
	model = "Milk-V Duo256M";

	/* Onboard blue LED: gpio354 = porte line 2 (same pin as Milk-V's stock
	 * blink.sh, active high; pad muxed to GPIO by U-Boot cvi_board_init.c).
	 * leds-gpio + ledtrig-heartbeat are MODULES: `rmmod ledtrig_heartbeat
	 * leds_gpio` hands the pin back to /sys/class/gpio/gpio354. */
	leds {
		compatible = "gpio-leds";
		led-heartbeat {
			label = "heartbeat";
			gpios = <&porte 2 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};
	};
};

&mipi_rx {
	snsr-reset = <&portc 17 GPIO_ACTIVE_LOW>, <&portc 17 GPIO_ACTIVE_LOW>, <&portc 17 GPIO_ACTIVE_LOW>;
};

&i2c0 {
	status = "disabled";
};

&i2c4 {
	status = "disabled";
};

&spi2 {
	status = "okay";

	spidev@0 {
		status = "okay";
	};
};

&dac {
	mute-gpio-r = <&porte 1 GPIO_ACTIVE_LOW>;
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

